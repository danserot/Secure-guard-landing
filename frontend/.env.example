# Real API is the default. Set true explicitly for standalone browser demo data.
VITE_API_URL=https://api.example.com
VITE_USE_MOCK_API=false

# Accessible HTTPS frontend URL used in phone-camera QR codes.
VITE_PHONE_PUBLIC_URL=https://camera.example.com
# Optional RTCIceServer JSON for connections outside the local Wi-Fi.
VITE_PHONE_ICE_SERVERS=[]

# Public lead intake. Leave empty until a real receiver is configured.
# POST JSON -> HTTP 2xx + { "accepted": true, "requestId": "durable-record-id" }
# Only set this to a trusted same-origin path or HTTPS endpoint.
VITE_LEAD_ENDPOINT=
